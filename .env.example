# Скопируйте этот файл в .env.local и заполните реальными значениями.
# Все переменные здесь — только серверные (не попадают в клиентский код).

# ── Отправка заявок на email (nodemailer через SMTP) ──────────────
# Пример для Gmail: включите 2FA и создайте «пароль приложения»:
# https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
# true для порта 465 (SSL); для 587 (STARTTLS) можно не задавать
SMTP_SECURE="true"
SMTP_USER="you@gmail.com"
SMTP_PASS="<app password>"
# Куда приходить будут заявки (можно несколько адресов через запятую)
LEAD_EMAIL_TO="leads@company.com"
# Необязательно: имя отправителя и reply-to
# LEAD_EMAIL_FROM="NEXAFLOW Landing <you@gmail.com>"
# LEAD_EMAIL_REPLY_TO="hello@company.com"

# ── Резервный канал: webhook в CRM / n8n / Make / Telegram ────────
# Можно использовать вместе с email или вместо него.
# LEAD_WEBHOOK_URL="https://hooks.example.com/leads"
# LEAD_WEBHOOK_SECRET="<optional bearer token>"
